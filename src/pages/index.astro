---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CorrosionPromo from '../components/CorrosionPromo.astro';
import Services from '../components/Services.astro';
import WhyUs from '../components/WhyUs.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Contact from '../components/Contact.astro';
import CallbackForm from '../components/CallbackForm.astro';
import FloatingBar from '../components/FloatingBar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <CorrosionPromo />
    <Services />
    <WhyUs />
    <HowItWorks />
    <Contact />
    <CallbackForm />
  </main>
  <Footer />
  <FloatingBar />
</BaseLayout>
