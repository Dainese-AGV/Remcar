---
import { site } from '../data/site';
---

<section id="callback" class="py-16 sm:py-20 bg-brand-dark">
  <div class="container-main">
    <div class="mx-auto max-w-xl text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Перезвоним в рабочее время</h2>
      <p class="mt-3 text-slate-300">В будни с 9:00 до 19:00 мастер свяжется в течение 15 минут</p>
    </div>

    <form
      id="callback-form"
      class="mx-auto mt-10 max-w-md space-y-4"
      novalidate
    >
      <div>
        <label for="name" class="block text-sm font-medium text-slate-300 mb-1.5">Ваше имя</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          placeholder="Иван"
          class="w-full rounded-xl border-0 bg-white/10 px-4 py-3 text-white placeholder:text-slate-500 ring-1 ring-white/20 focus:ring-2 focus:ring-brand-accent focus:outline-none"
        />
      </div>

      <div>
        <label for="phone" class="block text-sm font-medium text-slate-300 mb-1.5">Телефон</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          autocomplete="tel"
          value="+375 "
          placeholder="+375 (29) 772-61-01"
          inputmode="tel"
          class="w-full rounded-xl border-0 bg-white/10 px-4 py-3 text-white placeholder:text-slate-500 ring-1 ring-white/20 focus:ring-2 focus:ring-brand-accent focus:outline-none"
        />
      </div>

      <div>
        <label for="comment" class="block text-sm font-medium text-slate-300 mb-1.5">
          Комментарий <span class="text-slate-500">(необязательно)</span>
        </label>
        <textarea
          id="comment"
          name="comment"
          rows="3"
          placeholder="Опишите проблему или марку авто"
          class="w-full rounded-xl border-0 bg-white/10 px-4 py-3 text-white placeholder:text-slate-500 ring-1 ring-white/20 focus:ring-2 focus:ring-brand-accent focus:outline-none resize-none"
        ></textarea>
      </div>

      <!-- Honeypot — скрытое поле от ботов -->
      <div class="hidden" aria-hidden="true">
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <label class="flex items-start gap-3 text-left text-xs leading-relaxed text-slate-400">
        <input
          type="checkbox"
          id="consent"
          name="consent"
          value="yes"
          class="mt-0.5 h-4 w-4 shrink-0 rounded border-white/40 accent-orange-500"
        />
        <span>
          Даю согласие {site.legalName} на обработку имени, телефона и комментария в течение 1 года, чтобы связаться со мной по заявке, включая передачу этих данных в Telegram за пределы Беларуси. Уровень защиты у получателя может отличаться от белорусского.{' '}
          <a href="/privacy" class="text-slate-200 underline underline-offset-2 hover:text-white" target="_blank" rel="noopener noreferrer">Политика обработки персональных данных</a>
        </span>
      </label>

      <button type="submit" id="callback-submit" class="btn-primary w-full text-base">
        Жду звонка
      </button>

      <p id="callback-message" class="hidden text-center text-sm" role="alert"></p>
    </form>

    <div class="mt-8 text-center">
      <p class="text-slate-400 text-sm">Или позвоните сами:</p>
      <a
        href={`tel:${site.phoneMain.tel}`}
        class="mt-2 inline-block text-2xl font-bold text-brand-accent hover:text-orange-300 transition-colors"
      >
        {site.phoneMain.display}
      </a>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('callback-form') as HTMLFormElement;
  const messageEl = document.getElementById('callback-message') as HTMLParagraphElement;
  const submitBtn = document.getElementById('callback-submit') as HTMLButtonElement;
  const phoneInput = document.getElementById('phone') as HTMLInputElement;
  const consentInput = document.getElementById('consent') as HTMLInputElement;

  const defaultPhoneValue = '+375 ';

  function extractNationalDigits(value: string): string {
    let digits = value.replace(/\D/g, '');
    if (digits.startsWith('375')) {
      digits = digits.slice(3);
    }
    return digits.slice(0, 9);
  }

  function formatBelarusPhone(nationalDigits: string): string {
    const d = nationalDigits;
    if (d.length === 0) return defaultPhoneValue;
    if (d.length < 2) return `+375 (${d}`;
    if (d.length === 2) return `+375 (${d}) `;

    let formatted = `+375 (${d.slice(0, 2)}) ${d.slice(2, 5)}`;
    if (d.length <= 5) return formatted;

    formatted += `-${d.slice(5, 7)}`;
    if (d.length <= 7) return formatted;

    return `${formatted}-${d.slice(7, 9)}`;
  }

  function applyPhoneMask() {
    if (!phoneInput) return;
    const digits = extractNationalDigits(phoneInput.value);
    phoneInput.value = formatBelarusPhone(digits);
    phoneInput.setSelectionRange(phoneInput.value.length, phoneInput.value.length);
  }

  phoneInput?.addEventListener('focus', () => {
    if (!phoneInput.value.trim() || phoneInput.value === '+375') {
      phoneInput.value = defaultPhoneValue;
    }
    applyPhoneMask();
  });

  phoneInput?.addEventListener('input', applyPhoneMask);

  phoneInput?.addEventListener('keydown', (e) => {
    if (!phoneInput) return;
    const { selectionStart, selectionEnd, value } = phoneInput;
    if (selectionStart === null || selectionEnd === null) return;

    const prefixLength = defaultPhoneValue.length;
    const isBackspace = e.key === 'Backspace';
    const isDelete = e.key === 'Delete';

    if (isBackspace && selectionStart <= prefixLength && selectionEnd <= prefixLength) {
      e.preventDefault();
      return;
    }

    if (isDelete && selectionStart < prefixLength) {
      e.preventDefault();
      phoneInput.setSelectionRange(prefixLength, prefixLength);
    }
  });

  phoneInput?.addEventListener('blur', () => {
    if (!phoneInput) return;
    if (extractNationalDigits(phoneInput.value).length === 0) {
      phoneInput.value = defaultPhoneValue;
    }
  });

  function validatePhone(phone: string): boolean {
    const digits = phone.replace(/\D/g, '');
    return digits.length === 12 && digits.startsWith('375');
  }

  function resetPhoneField() {
    if (phoneInput) {
      phoneInput.value = defaultPhoneValue;
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const name = (formData.get('name') as string)?.trim();
    const phone = (formData.get('phone') as string)?.trim();
    const comment = (formData.get('comment') as string)?.trim();

    messageEl.classList.add('hidden');

    if (!name || name.length < 2) {
      showMessage('Введите ваше имя', 'error');
      return;
    }

    if (!validatePhone(phone)) {
      showMessage('Введите корректный номер телефона', 'error');
      return;
    }

    if (!consentInput?.checked) {
      showMessage('Подтвердите согласие на обработку персональных данных', 'error');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Отправка...';

    try {
      const response = await fetch('/api/callback.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          phone,
          comment,
          consent: true,
          website: formData.get('website'),
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || 'Ошибка отправки');
      }

      form.reset();
      resetPhoneField();
      showMessage('Заявка отправлена. В рабочее время перезвоним в течение 15 минут.', 'success');
    } catch (err) {
      console.error('Callback form error:', err);
      showMessage('Не удалось отправить заявку. Позвоните нам напрямую.', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Жду звонка';
    }
  });

  function showMessage(text: string, type: 'success' | 'error') {
    messageEl.textContent = text;
    messageEl.classList.remove('hidden', 'text-green-400', 'text-red-400');
    messageEl.classList.add(type === 'success' ? 'text-green-400' : 'text-red-400');
  }
</script>
