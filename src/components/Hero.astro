---
import { site } from '../data/site';
---

<section class="relative overflow-x-clip text-white">
  <div class="absolute inset-0 bg-gradient-to-br from-slate-800 via-slate-700 to-slate-800" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(249,115,22,0.15),transparent_55%)]" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(148,163,184,0.12),transparent_50%)]" aria-hidden="true"></div>

  <div class="container-main relative py-16 sm:py-24 lg:py-28">
    <div class="grid min-w-0 items-start gap-12 lg:grid-cols-2">
      <div class="min-w-0">
        <div class="mb-4 inline-flex max-w-full items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-slate-200">
          <span class="h-2 w-2 shrink-0 rounded-full bg-brand-accent animate-pulse"></span>
          <span class="min-w-0 leading-snug">
            <span>Пн–Пт, 9:00–19:00</span>
            <span class="mx-1 hidden sm:inline" aria-hidden="true">·</span>
            <span class="max-sm:block">{site.address.street}</span>
          </span>
        </div>

        <h1 class="max-w-full text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl tracking-tight">
          {site.tagline}
          <span class="block text-slate-200 mt-2 text-3xl sm:text-4xl font-semibold">в {site.cityIn}</span>
        </h1>

        <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-lg">
          {site.slogan}
        </p>
        <p class="mt-3 text-base text-slate-300 leading-relaxed max-w-lg">
          {site.brandsNote}
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a href={`tel:${site.phoneMain.tel}`} class="btn-primary">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {site.phoneMain.display}
          </a>
          <a href={site.messengers.telegram} target="_blank" rel="noopener noreferrer" class="btn-secondary border-slate-500 text-white bg-white/5 hover:bg-white hover:text-brand-dark">
            <svg class="h-5 w-5 fill-[#229ED9]" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
            </svg>
            Telegram
          </a>
        </div>
      </div>

      <div class="relative min-w-0">
        <a href="#promo" class="block group h-full">
          <div class="h-full rounded-2xl bg-white/10 p-6 ring-1 ring-white/15 transition group-hover:bg-white/15">
            <p class="text-2xl font-bold">{site.promo.title}</p>
            <p class="mt-2 text-slate-300 text-sm">{site.promo.subtitle}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-accent group-hover:gap-2 transition-all">
              Подробнее об обработке
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>
