---
import { site } from '../data/site';
---

<header class="sticky top-0 z-50 border-b border-slate-200/50 bg-white/90 backdrop-blur-md">
  <div class="container-main flex h-16 items-center justify-between gap-4">
    <a href="#" class="flex items-center gap-2 shrink-0">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-accent text-white font-bold text-sm">
        R
      </div>
      <div class="hidden sm:block">
        <div class="text-base font-bold text-brand-dark leading-tight tracking-tight">{site.name}</div>
        <div class="text-xs text-brand-muted">{site.tagline}</div>
      </div>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Основная навигация">
      <a href="#promo" class="text-sm font-medium text-brand-accent hover:text-brand-accent-hover transition-colors">Акция</a>
      <a href="#services" class="text-sm font-medium text-brand-text hover:text-brand-accent transition-colors">Услуги</a>
      <a href="#advantages" class="text-sm font-medium text-brand-text hover:text-brand-accent transition-colors">О нас</a>
      <a href="#contacts" class="text-sm font-medium text-brand-text hover:text-brand-accent transition-colors">Контакты</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.phoneMain.tel}`}
        class="hidden sm:flex items-center gap-1.5 text-sm font-semibold text-brand-dark hover:text-brand-accent transition-colors"
      >
        <svg class="h-4 w-4 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {site.phoneMain.display}
      </a>
      <a href="#callback" class="btn-primary text-sm px-4 py-2 min-h-9">
        Заказать звонок
      </a>
    </div>
  </div>
</header>
