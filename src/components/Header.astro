---
import { site } from '../data/site';

const onHome = Astro.url.pathname === '/';
const to = (id: string) => (onHome ? `#${id}` : `/#${id}`);
---

<header class="site-header fixed inset-x-0 top-0 z-50 h-16 border-b border-slate-200/60 bg-white">
  <div class="container-main flex h-full min-w-0 items-center justify-between gap-4">
    <a href={onHome ? '#' : '/'} class="flex items-center gap-2 shrink-0">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-accent text-white font-bold text-sm">
        R
      </div>
      <div class="hidden sm:block">
        <div class="text-base font-bold text-brand-dark leading-tight tracking-tight">{site.name}</div>
        <div class="text-xs text-brand-muted">{site.tagline}</div>
      </div>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Основная навигация">
      <a href={to('promo')} class="whitespace-nowrap text-sm font-medium text-brand-accent hover:text-brand-accent-hover transition-colors">Антикор</a>
      <a href={to('services')} class="whitespace-nowrap text-sm font-medium text-brand-text hover:text-brand-accent transition-colors">Услуги</a>
      <a href={to('advantages')} class="whitespace-nowrap text-sm font-medium text-brand-text hover:text-brand-accent transition-colors">О нас</a>
      <a href={to('contacts')} class="whitespace-nowrap text-sm font-medium text-brand-text hover:text-brand-accent transition-colors">Контакты</a>
    </nav>

    <a href={to('callback')} class="btn-primary shrink-0 px-4 py-2 text-sm min-h-9">
      Заказать звонок
    </a>
  </div>
</header>
<div class="h-16" aria-hidden="true"></div>
