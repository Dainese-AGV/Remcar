---
import { site } from '../data/site';
---

<section class="py-16 sm:py-20">
  <div class="container-main">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="section-title">Как записаться</h2>
      <p class="section-subtitle">Три простых шага — и ваш автомобиль в надёжных руках</p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {
        site.steps.map((step, index) => (
          <div class="relative text-center">
            {index < site.steps.length - 1 && (
              <div class="absolute top-8 left-1/2 hidden h-0.5 w-full bg-brand-accent/30 md:block" aria-hidden="true" />
            )}
            <div class="relative mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-brand-accent text-2xl font-bold text-white shadow-lg">
              {step.number}
            </div>
            <h3 class="text-lg font-semibold text-brand-dark">{step.title}</h3>
            <p class="mt-2 text-sm text-brand-muted">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
