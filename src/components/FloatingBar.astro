---
import { site } from '../data/site';
import Messengers from './Messengers.astro';

const primaryPhone = site.phoneMain;
---

<!-- Плавающая панель мессенджеров (справа) -->
<div class="fixed bottom-24 right-4 z-40 hidden sm:block">
  <Messengers variant="floating" />
</div>

<!-- Мобильная нижняя панель -->
<div class="fixed bottom-0 left-0 right-0 z-40 border-t border-slate-200 bg-white/95 backdrop-blur-sm sm:hidden">
  <div class="flex items-center justify-around px-2 py-2">
    <a
      href={`tel:${primaryPhone.tel}`}
      class="flex flex-col items-center gap-1 px-3 py-1 text-brand-accent"
      aria-label="Позвонить"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span class="text-xs font-semibold">Позвонить</span>
    </a>

    <a
      href={site.messengers.telegram}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center gap-1 px-3 py-1 text-[#229ED9]"
      aria-label="Telegram"
    >
      <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
      </svg>
      <span class="text-xs font-semibold">Telegram</span>
    </a>

    <a
      href={site.messengers.viber}
      class="flex flex-col items-center gap-1 px-3 py-1 text-[#7360F2]"
      aria-label="Viber"
    >
      <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
        <path d="M11.4 0C7.3 0 3.8 1.5 1.4 4.1c-1.5 1.6-1.4 4.1-.8 6.1.6 2.1 1.7 4 3.1 5.6l-.5 2.8 3.1-1.5c1.3.4 2.7.6 4.1.6 4.1 0 7.6-1.5 10-4.1 1.5-1.6 1.4-4.1.8-6.1-.6-2.1-1.7-4-3.1-5.6C17.1 1.5 14.5 0 11.4 0zm5.8 13.5c-.2.6-1.1 1.1-1.8 1.2-.5.1-1.1.1-1.7 0-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.7-4.4-3.9-.1-.2-.9-1.2-.9-2.3 0-1.1.6-1.6.8-1.8.2-.2.5-.3.7-.3h.5c.2 0 .4-.1.6.4.2.5.7 1.7.8 1.8.1.1.1.3 0 .4-.1.2-.2.3-.3.4-.1.1-.2.2-.1.4.1.2.5 1 1.2 1.6.8.7 1.5.9 1.7 1 .2.1.3.1.4-.1.1-.2.5-.6.6-.8.1-.2.3-.2.5-.1.2.1 1.3.6 1.5.7.2.1.3.2.4.3-.1.1-.1.3-.3.5z"/>
      </svg>
      <span class="text-xs font-semibold">Viber</span>
    </a>

    <a
      href="#callback"
      class="flex flex-col items-center gap-1 px-3 py-1 text-brand-dark"
      aria-label="Заказать звонок"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      <span class="text-xs font-semibold">Заявка</span>
    </a>
  </div>
</div>

<!-- Отступ снизу на мобильном, чтобы контент не перекрывался -->
<div class="h-16 sm:hidden" aria-hidden="true"></div>
