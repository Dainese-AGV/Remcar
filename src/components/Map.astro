---
import { site } from '../data/site';

const { lat, lon, full } = site.address;

const yandexEmbed = `https://yandex.ru/map-widget/v1/?ll=${lon}%2C${lat}&z=18&pt=${lon}%2C${lat}%2Cpm2rdm`;
const yandexNavi = `yandexnavi://build_route_on_map?lat_to=${lat}&lon_to=${lon}`;
const googleNavi = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}&travelmode=driving`;
---

<div class="overflow-hidden rounded-2xl ring-1 ring-slate-200/60">
  <iframe
    src={yandexEmbed}
    width="100%"
    height="360"
    frameborder="0"
    allowfullscreen
    title={`Карта — ${full}`}
    loading="lazy"
    class="w-full"
  ></iframe>

  <div class="flex flex-wrap gap-3 bg-white p-4">
    <a
      href={yandexNavi}
      class="inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-lg bg-[#FC3F1D] px-4 py-2 text-sm font-semibold text-white hover:bg-[#e0381a] transition-colors sm:flex-none"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
      </svg>
      Яндекс.Навигатор
    </a>
    <a
      href={googleNavi}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-brand-dark hover:bg-slate-50 transition-colors sm:flex-none"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
      </svg>
      Google Навигатор
    </a>
  </div>
</div>
