---
import { site } from '../data/site';
import Messengers from './Messengers.astro';
import Map from './Map.astro';
---

<section id="contacts" class="py-16 sm:py-20">
  <div class="container-main">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="section-title">Контакты</h2>
      <p class="section-subtitle">Приезжайте или свяжитесь удобным способом</p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <div class="space-y-6">
        <div class="card">
          <h3 class="font-semibold text-brand-dark mb-4">Как нас найти</h3>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <div>
                <div class="font-medium text-brand-dark">{site.address.full}</div>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <div>
                <a href={`tel:${site.phoneMain.tel}`} class="text-lg font-semibold text-brand-dark hover:text-brand-accent transition-colors">
                  {site.phoneMain.display}
                </a>
                <div class="text-sm text-brand-muted">{site.phoneMain.note}</div>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-[#229ED9]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
              <div>
                <a href={site.messengers.telegram} target="_blank" rel="noopener noreferrer" class="text-lg font-semibold text-brand-dark hover:text-brand-accent transition-colors">
                  {site.phoneTelegram.display}
                </a>
                <div class="text-sm text-brand-muted">{site.phoneTelegram.note}</div>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <svg class="h-5 w-5 shrink-0 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <a href={`mailto:${site.email}`} class="text-brand-dark hover:text-brand-accent transition-colors">
                {site.email}
              </a>
            </div>
          </div>
        </div>

        <div class="card">
          <h3 class="font-semibold text-brand-dark mb-4">Режим работы</h3>
          <dl class="space-y-2">
            {
              site.schedule.map((item) => (
                <div class="flex justify-between text-sm">
                  <dt class="text-brand-muted">{item.days}</dt>
                  <dd class="font-medium text-brand-dark">{item.hours}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="card">
          <h3 class="font-semibold text-brand-dark mb-4">Мессенджеры</h3>
          <p class="text-sm text-brand-muted mb-4">Ответим в рабочие дни с 9:00 до 19:00</p>
          <Messengers />
        </div>
      </div>

      <Map />
    </div>
  </div>
</section>
