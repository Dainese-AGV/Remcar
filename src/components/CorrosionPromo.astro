---
import { site } from '../data/site';
---

<section id="promo" class="py-12 sm:py-16">
  <div class="container-main">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-orange-500 via-brand-accent to-amber-600 p-8 sm:p-10 text-white shadow-xl shadow-orange-500/20 [contain:paint]">
      <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-2xl" aria-hidden="true"></div>
      <div class="absolute -bottom-20 -left-10 h-48 w-48 rounded-full bg-black/10 blur-2xl" aria-hidden="true"></div>

      <div class="relative grid min-w-0 gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <h2 class="text-3xl font-bold sm:text-4xl tracking-tight">{site.promo.title}</h2>
          <p class="mt-3 text-lg text-orange-50 max-w-xl">{site.promo.subtitle}</p>
          <p class="mt-4 text-sm text-orange-100/90 leading-relaxed max-w-xl">{site.promo.details}</p>
        </div>

        <div class="flex w-full min-w-0 flex-col gap-3 sm:w-auto sm:flex-row lg:flex-col">
          <a href={`tel:${site.phoneMain.tel}`} class="flex min-h-12 w-full min-w-0 flex-col items-center justify-center gap-0.5 rounded-xl bg-white px-5 py-3 text-center font-semibold leading-tight text-brand-accent hover:bg-orange-50 transition-colors sm:w-auto sm:flex-row sm:gap-1">
            <span>Позвонить:</span>
            <span>{site.phoneMain.display}</span>
          </a>
          <a href="#callback" class="inline-flex min-h-12 items-center justify-center rounded-xl border-2 border-white/80 px-6 py-3 text-center font-semibold text-white hover:bg-white/10 transition-colors">
            Оставить заявку
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
