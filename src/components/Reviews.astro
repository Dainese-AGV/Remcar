---
import { site } from '../data/site';
---

<section id="reviews" class="py-16 sm:py-20 bg-white">
  <div class="container-main">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="section-title">Отзывы клиентов</h2>
      <p class="section-subtitle">Нам доверяют — и возвращаются снова</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        site.reviews.map((review) => (
          <div class="card">
            <div class="mb-3 flex gap-0.5" aria-label={`Оценка: ${review.rating} из 5`}>
              {
                Array.from({ length: review.rating }).map(() => (
                  <svg class="h-5 w-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))
              }
            </div>
            <p class="text-brand-text leading-relaxed">«{review.text}»</p>
            <div class="mt-4 border-t border-slate-100 pt-4">
              <div class="font-semibold text-brand-dark">{review.author}</div>
              <div class="text-sm text-brand-muted">{review.car}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
