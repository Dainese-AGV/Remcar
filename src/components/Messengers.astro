---
import { site } from '../data/site';

interface Props {
  variant?: 'inline' | 'floating';
}

const { variant = 'inline' } = Astro.props;

const items = [
  {
    name: 'Telegram',
    href: site.messengers.telegram,
    bg: 'bg-[#229ED9]',
    hover: 'hover:bg-[#1d8fc7]',
    subtitle: site.phoneTelegram.display,
    external: true,
  },
  {
    name: 'Viber',
    href: site.messengers.viber,
    bg: 'bg-[#7360F2]',
    hover: 'hover:bg-[#6350e0]',
    subtitle: site.phoneMain.display,
    external: false,
  },
];
---

<div class={variant === 'floating' ? 'flex flex-col gap-3' : 'grid gap-3 sm:grid-cols-2'}>
  {
    items.map((item) =>
      variant === 'floating' ? (
        <a
          href={item.href}
          target={item.external ? '_blank' : '_self'}
          rel={item.external ? 'noopener noreferrer' : undefined}
          class={`flex h-12 w-12 items-center justify-center rounded-full text-white shadow-lg transition-transform hover:scale-110 ${item.bg} ${item.hover}`}
          aria-label={`Написать в ${item.name}`}
          title={item.name}
        >
          {item.name === 'Telegram' ? (
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
            </svg>
          ) : (
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M11.4 0C7.3 0 3.8 1.5 1.4 4.1c-1.5 1.6-1.4 4.1-.8 6.1.6 2.1 1.7 4 3.1 5.6l-.5 2.8 3.1-1.5c1.3.4 2.7.6 4.1.6 4.1 0 7.6-1.5 10-4.1 1.5-1.6 1.4-4.1.8-6.1-.6-2.1-1.7-4-3.1-5.6C17.1 1.5 14.5 0 11.4 0zm5.8 13.5c-.2.6-1.1 1.1-1.8 1.2-.5.1-1.1.1-1.7 0-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.7-4.4-3.9-.1-.2-.9-1.2-.9-2.3 0-1.1.6-1.6.8-1.8.2-.2.5-.3.7-.3h.5c.2 0 .4-.1.6.4.2.5.7 1.7.8 1.8.1.1.1.3 0 .4-.1.2-.2.3-.3.4-.1.1-.2.2-.1.4.1.2.5 1 1.2 1.6.8.7 1.5.9 1.7 1 .2.1.3.1.4-.1.1-.2.5-.6.6-.8.1-.2.3-.2.5-.1.2.1 1.3.6 1.5.7.2.1.3.2.4.3-.1.1-.1.3-.3.5z"/>
            </svg>
          )}
        </a>
      ) : (
        <a
          href={item.href}
          target={item.external ? '_blank' : '_self'}
          rel={item.external ? 'noopener noreferrer' : undefined}
          class="flex items-center gap-3 rounded-xl border border-slate-200/80 bg-slate-50/80 p-4 transition-colors hover:border-brand-accent/30 hover:bg-white"
        >
          <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-white ${item.bg}`}>
            {item.name === 'Telegram' ? (
              <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
            ) : (
              <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M11.4 0C7.3 0 3.8 1.5 1.4 4.1c-1.5 1.6-1.4 4.1-.8 6.1.6 2.1 1.7 4 3.1 5.6l-.5 2.8 3.1-1.5c1.3.4 2.7.6 4.1.6 4.1 0 7.6-1.5 10-4.1 1.5-1.6 1.4-4.1.8-6.1-.6-2.1-1.7-4-3.1-5.6C17.1 1.5 14.5 0 11.4 0zm5.8 13.5c-.2.6-1.1 1.1-1.8 1.2-.5.1-1.1.1-1.7 0-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.7-4.4-3.9-.1-.2-.9-1.2-.9-2.3 0-1.1.6-1.6.8-1.8.2-.2.5-.3.7-.3h.5c.2 0 .4-.1.6.4.2.5.7 1.7.8 1.8.1.1.1.3 0 .4-.1.2-.2.3-.3.4-.1.1-.2.2-.1.4.1.2.5 1 1.2 1.6.8.7 1.5.9 1.7 1 .2.1.3.1.4-.1.1-.2.5-.6.6-.8.1-.2.3-.2.5-.1.2.1 1.3.6 1.5.7.2.1.3.2.4.3-.1.1-.1.3-.3.5z"/>
              </svg>
            )}
          </span>
          <span class="text-sm">
            <span class="block font-semibold text-brand-dark">{item.name}</span>
            <span class="block text-brand-muted">{item.subtitle}</span>
          </span>
        </a>
      ),
    )
  }
</div>
